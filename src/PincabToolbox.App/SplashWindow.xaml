<Window x:Class="PincabToolbox.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pincab Toolbox"
        Width="520" Height="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <!-- ⚠ Volontairement SANS AllowsTransparency. Une fenêtre WPF transparente est une fenêtre
         « layered » au sens Win32 — exactement le profil incriminé dans le commentaire du .csproj
         à propos de l'ancien <SplashScreen>. Ici : fenêtre WPF ordinaire, opaque, créée depuis
         App.OnStartup une fois le Dispatcher démarré. Aucun P/Invoke, aucun code pré-init. -->
    <Border BorderBrush="{StaticResource Accent}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0"
                   Source="Assets/logo-full.png"
                   Stretch="Uniform"
                   Margin="40,36,40,12"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <Border Grid.Row="1" Height="3" Margin="0" VerticalAlignment="Bottom"
                    Background="{StaticResource Accent}"/>
        </Grid>
    </Border>
</Window>
