<Window x:Class="PincabToolbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pincab Toolbox"
        Icon="Assets/logo.png"
        Width="1180" Height="820" MinWidth="900" MinHeight="660"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="16,10" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource PanelAlt}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Border}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="DemoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF6E56CF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF5B47B0"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Border}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <!-- ══ Écran Scanner porté sur la maquette 11/08 — templates partagés ══
             Chaque template est utilisé à DEUX endroits (colonne de droite + onglet dédié),
             d'où leur place ici plutôt qu'en inline : une seule définition, zéro dérive. -->

        <!-- Une ligne du tableau des tables analysées. Chaque cellule est alimentée en
             code-behind depuis un vrai résultat de scan ; "—" = non vérifié sur ce scan. -->
        <DataTemplate x:Key="TableRowTpl">
            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Rom}" Foreground="{Binding RomBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Rom}"/>
                    <TextBlock Grid.Column="2" Text="{Binding B2s}" Foreground="{Binding B2sBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding Frontend}" Foreground="{Binding FeBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Une ligne de santé de composant : nom / fait mesuré (bitness, base lue…) / statut. -->
        <DataTemplate x:Key="CompRowTpl">
            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                               FontSize="11.5" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" Foreground="{StaticResource TextDim}"
                               FontSize="11.5" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Une ligne des encadrés « Résultats critiques » / « Remarques » — cliquable,
             renvoie vers la ligne correspondante de l'onglet Tous les résultats. -->
        <DataTemplate x:Key="SideRowTpl">
            <Border Background="Transparent" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                    Padding="13,9" Cursor="Hand" MouseLeftButtonUp="SideRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{Binding Dot}" Margin="0,5,9,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                        <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource TextDim}" Margin="8,0,0,0" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Carte de cause racine (maquette 11/08) : badge de gravité, titre, puce de confiance,
             phrase joueur, phrase d'impact, chaîne causale, pied (touché / codes / manuel / étapes).
             Tout est construit en code-behind depuis Scenarios.DetectAll — jamais écrit en dur. -->
        <DataTemplate x:Key="CauseCardTpl">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="12,0,0,12"/>
                    <StackPanel Grid.Column="1">
                        <StackPanel Margin="16,12,16,12">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Background="{Binding BadgeBg}" BorderBrush="{Binding BadgeBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="{Binding AccentBrush}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConfText}" Foreground="{StaticResource TextDim}" FontSize="11"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Margin="10,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Player}" FontSize="13" TextWrapping="Wrap" Margin="0,9,0,0"/>
                            <TextBlock Text="{Binding Impact}" Foreground="{StaticResource TextDim}" FontSize="12.5"
                                       TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding ImpactVis}"/>
                            <ItemsControl ItemsSource="{Binding Chain}" Margin="0,11,0,0" Visibility="{Binding ChainVis}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Arrow}" Foreground="{Binding ArrowBrush}" FontSize="13"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                            <Border Background="{Binding NodeBg}" BorderBrush="{Binding NodeBorder}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{Binding StatusBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Background="#FF1A1A22" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,12,0" Padding="16,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding StepsLabel}" Click="CauseSteps_Click"
                                        Padding="10,4" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ManualText}" Foreground="{StaticResource Warning}"
                                           FontSize="12" VerticalAlignment="Center" Visibility="{Binding ManualVis}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FootComponents}" Foreground="{StaticResource TextDim}" FontSize="12"
                                               Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding FootComponentsVis}"/>
                                    <TextBlock Text="{Binding FootTables}" Foreground="{StaticResource TextDim}" FontSize="12"
                                               Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding FootTablesVis}"/>
                                    <TextBlock Text="{Binding FootCodes}" Foreground="{StaticResource TextDim}" FontFamily="Consolas"
                                               FontSize="11.5" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,7">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Logo MC Automation, fond détouré pour se poser sur le bleu nuit du bandeau.
                         L'emblème seul : le nom du produit reste du texte juste à côté, donc net à
                         toutes les résolutions et sélectionnable, plutôt que pixellisé dans l'image. -->
                    <Image Source="Assets/logo.png" Height="30" Margin="0,0,10,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PINCAB" FontSize="19" FontWeight="Black" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text=" TOOLBOX" FontSize="19" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderTagline" Text="" FontSize="13" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" Margin="14,4,0,0"/>
                </StackPanel>
                <Button x:Name="BtnLang" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="FR / EN" Click="BtnLang_Click"/>
            </DockPanel>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,6,10,0">

            <!-- ============ SCANNER ============ -->
            <TabItem x:Name="TabScanner">
                <TabItem.Header><TextBlock x:Name="TabScannerHeader" Text="Scanner" FontSize="14"/></TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Plancher garanti pour la zone de contenu (dont le tableau des
                             résultats, qui la remplit entièrement dans son onglet) : c'est le
                             contenu principal de l'écran, il ne doit jamais être écrasé par ce
                             qu'on ajoute au-dessus (bandeau, ligne méta). Sans ce MinHeight,
                             chaque bloc décoratif ajouté lui volait des pixels — c'est
                             exactement ce qui s'est produit. -->
                        <RowDefinition Height="*" MinHeight="240"/>
                    </Grid.RowDefinitions>

                    <!-- path row -->
                    <Grid Grid.Row="0" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblRoot" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtRoot" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="TxtRoot_TextChanged"/>
                        <Button x:Name="BtnBrowse" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource BrowseButton}" Click="BtnBrowse_Click"/>
                        <Button x:Name="BtnDemo" Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource DemoButton}" Click="BtnDemo_Click"/>
                        <!-- La recherche vit dans la barre du haut, pas sur une ligne à elle :
                             une ligne dédiée coûtait ~40 px pris sur le tableau, pour un champ
                             qui tient à côté des boutons existants. -->
                        <Grid Grid.Column="4" Width="230" Margin="14,0,0,0">
                            <TextBox x:Name="TxtSearch" VerticalContentAlignment="Center" Padding="6,0,0,0"
                                     Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                                     BorderBrush="{StaticResource Border}" TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock x:Name="SearchHint" IsHitTestVisible="False" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="9,0,0,0"/>
                        </Grid>
                    </Grid>

                    <!-- ══════════════════ BANDEAU (maquette du 11/08) ══════════════════
                         Jauge + accroche + pastilles de gravité + actions, sur la scène d'arcade.
                         Les pastilles restent des FILTRES cliquables comme avant : mêmes x:Name,
                         mêmes gestionnaires, seule la mise en forme change. -->
                    <!-- Deux Border imbriqués de MÊME CornerRadius : un Border WPF ne rogne pas son
                         contenu aux coins arrondis, donc l'image de fond passe par son Background
                         (ImageBrush, qui suit le rayon) et le voile par le Background du Border
                         intérieur. Un Rectangle superposé laisserait 4 angles carrés visibles. -->
                    <Border Grid.Row="1" Margin="0,2,0,10" CornerRadius="14"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Border.Background>
                            <!-- Décor : salle d'arcade, image générée — titres de tables inventés
                                 (« Cosmic Eclipse », « Quantum Quest »…), donc aucun artwork réel
                                 de Bally/Williams/Stern, conformément à la règle du projet.
                                 UniformToFill + AlignmentY=Center : sur un écran large le bandeau
                                 fait ~1884x190 pour un asset 1920x430, donc SEULE LA BANDE
                                 CENTRALE de l'image est visible. Le cadrage a été calé pour ça —
                                 recadrer l'asset en gardant le sujet au centre, pas en haut. -->
                            <ImageBrush ImageSource="Assets/background.png" Stretch="UniformToFill" AlignmentY="Center" Opacity="0.95"/>
                        </Border.Background>
                        <Border CornerRadius="13">
                            <Border.Background>
                                <!-- Voile : garde le texte lisible sans noyer l'illustration.
                                     Renforcé le 12/08 avec la photo de salle d'arcade — bien plus
                                     lumineuse que l'illustration qu'elle remplace, l'accroche rouge
                                     ne passait plus sur les frontons éclairés. -->
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#DB0B111A" Offset="0"/>
                                    <GradientStop Color="#B80B111A" Offset="0.34"/>
                                    <GradientStop Color="#A30B111A" Offset="0.62"/>
                                    <GradientStop Color="#C70B111A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid Margin="16,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- ─── jauge ─── -->
                                <Grid x:Name="ScoreChip" Grid.Column="0" Width="92" Height="92"
                                      Visibility="Collapsed" Margin="0,0,18,0" VerticalAlignment="Center">
                                    <Ellipse Width="80" Height="80" Stroke="#1E2B3C" StrokeThickness="7"/>
                                    <!-- L'arc de progression est un cercle dont le tiret est calculé en
                                         code-behind (RefreshList) : circonférence / épaisseur = 35.34
                                         unités pour 100 %. Pas de géométrie d'arc à recalculer à la main.
                                         Si le diamètre ou l'épaisseur changent ici, ce nombre change aussi. -->
                                    <Ellipse x:Name="ScoreArc" Width="80" Height="80" StrokeThickness="7"
                                             Stroke="{StaticResource Critical}" StrokeDashCap="Round"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="ScoreValue" FontWeight="Black" FontSize="24"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ScoreGrade" FontWeight="Bold" FontSize="10"
                                                   HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ─── accroche + pastilles ─── -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroHeadline" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ScoreStatus" Foreground="{StaticResource TextDim}"
                                               FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>

                                    <WrapPanel Margin="0,9,0,0">
                                        <Border x:Name="PillCritical" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" MouseLeftButtonUp="PillCritical_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Critical}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipCritical" Text="0" Foreground="{StaticResource Critical}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PillWarning" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" MouseLeftButtonUp="PillWarning_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Warning}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipWarning" Text="0" Foreground="{StaticResource Warning}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PillNote" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" MouseLeftButtonUp="PillNote_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource NoteSev}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipNote" Text="0" Foreground="{StaticResource NoteSev}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PillInfo" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" MouseLeftButtonUp="PillInfo_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource InfoSev}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipInfo" Text="0" Foreground="{StaticResource InfoSev}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PillOk" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" Opacity="0.4" MouseLeftButtonUp="PillOk_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource OkSev}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipOk" Text="0" Foreground="{StaticResource OkSev}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- ─── actions ─── -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="240" Margin="14,0,0,0">
                                    <Button x:Name="BtnScan" Style="{StaticResource AccentButton}" Click="BtnScan_Click"
                                            Padding="14,9" FontSize="13.5" FontWeight="Bold"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnExport" Grid.Column="0" Click="BtnExport_Click" IsEnabled="False" Padding="4,7"/>
                                        <Button x:Name="BtnCopyForum" Grid.Column="2" Click="BtnCopyForum_Click" IsEnabled="False" Padding="4,7"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- ── ligne méta (maquette 11/08) : mode, horodatage, durée, contrôles, tables.
                         Chaque valeur vient du vrai ScanReport / ScanEngine, remplie en code-behind.
                         Avant le premier scan, la même rangée porte le texte d'accueil. ── -->
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="LblPlaceholder" Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" Margin="2,0,2,6"/>
                        <WrapPanel x:Name="MetaRow" Visibility="Collapsed" Margin="2,0,2,2">
                            <TextBlock x:Name="MetaMode" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,22,4"/>
                            <TextBlock x:Name="MetaStarted" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,22,4"/>
                            <TextBlock x:Name="MetaDuration" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,22,4"/>
                            <TextBlock x:Name="MetaChecks" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,22,4"/>
                            <TextBlock x:Name="MetaTables" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,22,4"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ══════════════ ONGLETS INTERNES (maquette 11/08) ══════════════
                         Causes racines / Tous les résultats / Composants / Tables / Système.
                         Même style d'onglet souligné que les onglets principaux. Le tableau des
                         résultats vit dans son onglet et y occupe TOUTE la zone de contenu, donc
                         le plancher MinHeight de la ligne du Grid le protège comme avant. -->
                    <TabControl x:Name="ScannerTabs" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0">

                        <!-- ══ CAUSES RACINES ══ -->
                        <TabItem x:Name="StabCauses">
                            <TabItem.Header><TextBlock x:Name="StabCausesHeader" Text="Causes racines" FontSize="13"/></TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="330"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <!-- Cartes de causes racines — Scenarios.DetectAll, triées
                                             gravité puis confiance. En repli (aucun scénario), une
                                             seule carte construite depuis le résultat le plus grave. -->
                                        <ItemsControl x:Name="CauseCards" ItemTemplate="{StaticResource CauseCardTpl}"/>

                                        <!-- État réparable — honnête (ADR-006) : l'offre réelle de
                                             RepairOfferBuilder quand elle existe, sinon la carte
                                             « aucune réparation automatique disponible ». -->
                                        <Border x:Name="RepairCard" Visibility="Collapsed" Background="{StaticResource Panel}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10">
                                            <Grid Margin="16,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="⚒" FontSize="16" Foreground="{StaticResource TextDim}" Margin="0,1,12,0" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="RepairCardTitle" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="RepairCardBody" Foreground="{StaticResource TextDim}" FontSize="12.5"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                                                    <!-- Écran 1 — free aggregate offer, computed by RepairOfferBuilder from the real plan -->
                                                    <TextBlock x:Name="RepairSummaryLine" Visibility="Collapsed" Foreground="{StaticResource Accent}"
                                                               FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <!-- ADR-006 anti-survente : ce que Repair NE fera jamais, même une fois acheté
                                                         (RepairOffer.NotAutomatable) — affiché AVANT l'achat, jamais caché. -->
                                                    <TextBlock x:Name="RepairNotAutomatableLine" Visibility="Collapsed" Foreground="{StaticResource TextDim}"
                                                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnRepairCardOpen" Grid.Column="2" Click="BtnGotoRepair_Click"
                                                        Padding="12,5" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>

                                        <!-- Tableau des tables analysées — données réelles du scan,
                                             une cellule sans résultat affiche « — », jamais une valeur déduite. -->
                                        <Border x:Name="TablesCard" Visibility="Collapsed" Background="{StaticResource Panel}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
                                                    <DockPanel>
                                                        <TextBlock x:Name="TablesCardCount" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="11"/>
                                                        <TextBlock x:Name="TablesCardHeader" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                    </DockPanel>
                                                </Border>
                                                <Border Background="#FF1A1A22" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1.4*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="TblHTable" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                        <TextBlock x:Name="TblHRom" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                        <TextBlock x:Name="TblHB2s" Grid.Column="2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                        <TextBlock x:Name="TblHFe" Grid.Column="3" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                    </Grid>
                                                </Border>
                                                <!-- Résumé plafonné (12 lignes) : un ItemsControl ne virtualise
                                                     pas, et une collection réelle peut faire 2000 tables
                                                     (FIELD-LOG 2026-07-30). La liste complète, virtualisée,
                                                     vit dans l'onglet Tables — le renvoi ci-dessous l'affiche. -->
                                                <ItemsControl x:Name="TablesList" ItemTemplate="{StaticResource TableRowTpl}"/>
                                                <TextBlock x:Name="TablesListMore" Visibility="Collapsed" Foreground="{StaticResource TextDim}"
                                                           FontSize="11.5" Padding="14,8"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ══ COLONNE DE DROITE (maquette 11/08) ══ -->
                                    <StackPanel Grid.Column="2">

                                        <Border x:Name="SideCritBox" Visibility="Collapsed" Background="{StaticResource Panel}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="13,10">
                                                    <DockPanel>
                                                        <TextBlock x:Name="SideCritCount" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="11"/>
                                                        <TextBlock x:Name="SideCritHeader" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                    </DockPanel>
                                                </Border>
                                                <!-- Plafonné à 8 lignes (une install cassée peut porter des
                                                     dizaines de critiques) — le total réel reste affiché dans
                                                     l'en-tête, la liste complète est dans Tous les résultats. -->
                                                <ItemsControl x:Name="SideCritList" ItemTemplate="{StaticResource SideRowTpl}"/>
                                                <TextBlock x:Name="SideCritMore" Visibility="Collapsed" Foreground="{StaticResource TextDim}"
                                                           FontSize="11" Padding="13,8"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Santé des composants : uniquement des lignes portées par un
                                             résultat réel (inventaire bitness, composant manquant, base
                                             Popper lue). Jamais de ligne déduite du silence d'un scanner. -->
                                        <Border x:Name="SideCompBox" Visibility="Collapsed" Background="{StaticResource Panel}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="13,10">
                                                    <DockPanel>
                                                        <TextBlock x:Name="SideCompCount" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="11"/>
                                                        <TextBlock x:Name="SideCompHeader" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                    </DockPanel>
                                                </Border>
                                                <ItemsControl x:Name="SideCompList" ItemTemplate="{StaticResource CompRowTpl}"/>
                                                <Border Background="#FF1A1A22" Padding="13,9" CornerRadius="0,0,12,12">
                                                    <TextBlock x:Name="SideCompNote" Foreground="{StaticResource TextDim}" FontSize="11"
                                                               TextWrapping="Wrap" LineHeight="16"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="SideNoteBox" Visibility="Collapsed" Background="{StaticResource Panel}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="13,10">
                                                    <DockPanel>
                                                        <TextBlock x:Name="SideNoteCount" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="11"/>
                                                        <TextBlock x:Name="SideNoteHeader" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                    </DockPanel>
                                                </Border>
                                                <ItemsControl x:Name="SideNoteList" ItemTemplate="{StaticResource SideRowTpl}"/>
                                                <TextBlock x:Name="SideNoteMore" Visibility="Collapsed" Foreground="{StaticResource TextDim}"
                                                           FontSize="11" Padding="13,8"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ══ TOUS LES RÉSULTATS ══ (le tableau existant, filtres et détail inchangés) -->
                        <TabItem x:Name="StabResults">
                            <TabItem.Header><TextBlock x:Name="StabResultsHeader" Text="Tous les résultats" FontSize="13"/></TabItem.Header>
                            <Grid Margin="0,8,0,0">

                    <ListView x:Name="ListFindings"
                              Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="ListFindings_SelectionChanged"
                              GridViewColumnHeader.Click="Header_Click"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Background" Value="{Binding RowBg}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="RowBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                      Columns="{TemplateBinding GridView.ColumnCollection}"
                                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#1FFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#4DFF9F1C"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="ColSeverity" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Fill="{Binding SevBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding SevLabel}" Foreground="{Binding SevBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ColCategory" Width="110" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn x:Name="ColSubject" Width="320">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ColMessage" Width="410">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ColAction" Header="Action" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ActionLabel}" Click="RowAction_Click"
                                                    Padding="9,3" FontSize="12" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- detail panel — populated on row selection -->
                    <Border x:Name="DetailPanel" VerticalAlignment="Bottom" Visibility="Collapsed" MaxHeight="250"
                            Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="8,0,8,8">
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,26,0">
                            <StackPanel>
                                <TextBlock x:Name="DetailSubject" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailMessage" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                <TextBlock x:Name="DetailImpactLabel" Foreground="{StaticResource TextDim}" FontSize="10.5" FontWeight="Bold" Margin="0,13,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="DetailImpact" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>

                                <TextBlock x:Name="DetailCauseLabel" Foreground="{StaticResource TextDim}" FontSize="10.5" FontWeight="Bold" Margin="0,11,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="DetailCause" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>

                                <TextBlock x:Name="DetailFixLabel" Foreground="{StaticResource TextDim}" FontSize="10.5" FontWeight="Bold" Margin="0,11,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="DetailFix" Foreground="{StaticResource OkSev}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>

                                <Button x:Name="DetailActionBtn" HorizontalAlignment="Left" Margin="0,13,0,0" Padding="14,7"
                                        FontWeight="SemiBold" Click="DetailAction_Click"/>

                                <Border x:Name="DetailRepairTag" Visibility="Collapsed" Background="#22FF9F1C" BorderBrush="#55FF9F1C" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,11,0,0" HorizontalAlignment="Left" MaxWidth="420">
                                    <StackPanel>
                                        <TextBlock x:Name="DetailRepairTagText" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" LineHeight="18"/>
                                        <Button x:Name="BtnGotoRepair" Click="BtnGotoRepair_Click" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" Padding="10,4" FontSize="11.5"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="DetailPath" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            </ScrollViewer>
                            <Button x:Name="BtnCloseDetail" Content="✕" ToolTip="Fermer" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="26" Height="26" Padding="0" FontSize="13" Click="BtnCloseDetail_Click"/>
                        </Grid>
                    </Border>
                            </Grid>
                        </TabItem>

                        <!-- ══ COMPOSANTS ══ (mêmes lignes que l'encadré de droite, pleine largeur) -->
                        <TabItem x:Name="StabComponents">
                            <TabItem.Header><TextBlock x:Name="StabComponentsHeader" Text="Composants" FontSize="13"/></TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,8,0,0" MaxWidth="780" HorizontalAlignment="Left">
                                    <Border x:Name="CompTabCard" Visibility="Collapsed" Background="{StaticResource Panel}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <ItemsControl x:Name="CompList" ItemTemplate="{StaticResource CompRowTpl}"/>
                                            <Border Background="#FF1A1A22" Padding="14,9" CornerRadius="0,0,12,12">
                                                <TextBlock x:Name="CompTabNote" Foreground="{StaticResource TextDim}" FontSize="11"
                                                           TextWrapping="Wrap" LineHeight="16"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="CompTabEmpty" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="2,4,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ══ TABLES ══ (le même tableau que la vue Causes racines, complet cette
                             fois : ListBox virtualisée — une collection réelle peut faire 2000
                             tables, un ItemsControl créerait 2000 lignes visuelles d'un coup) -->
                        <TabItem x:Name="StabTables">
                            <TabItem.Header><TextBlock x:Name="StabTablesHeader" Text="Tables" FontSize="13"/></TabItem.Header>
                            <Grid Margin="0,8,0,0">
                                <Border x:Name="TablesTabCard" Visibility="Collapsed" Background="{StaticResource Panel}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12"
                                        MaxWidth="920" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#FF1A1A22" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TblHTable2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock x:Name="TblHRom2" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock x:Name="TblHB2s2" Grid.Column="2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                                <TextBlock x:Name="TblHFe2" Grid.Column="3" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                            </Grid>
                                        </Border>
                                        <ListBox x:Name="TablesListFull" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                                 ItemTemplate="{StaticResource TableRowTpl}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <!-- Lignes non interactives : pas de focus ni de surbrillance
                                                     de sélection, le template de ligne porte déjà tout. -->
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TablesTabEmpty" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                           Margin="2,4,0,0" VerticalAlignment="Top"/>
                            </Grid>
                        </TabItem>

                        <!-- ══ SYSTÈME ══ — uniquement des faits mesurés : métadonnées du dernier
                             scan (ScanReport) et machine (OS, CPU, mémoire, écrans via
                             MonitorTopologyProbe). Pas de GPU : le lire demanderait WMI, hors
                             contrainte zéro-dépendance du projet. -->
                        <TabItem x:Name="StabSystem">
                            <TabItem.Header><TextBlock x:Name="StabSystemHeader" Text="Système" FontSize="13"/></TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="2,12,0,0" MaxWidth="820" HorizontalAlignment="Left">
                                    <TextBlock x:Name="SysScanHeader" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="SysScanBody" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,18" LineHeight="20"/>
                                    <TextBlock x:Name="SysMachineHeader" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="SysMachineBody" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- ============ DIFF ============ -->
            <TabItem x:Name="TabDiff">
                <TabItem.Header><TextBlock x:Name="TabDiffHeader" Text="Diff" FontSize="14"/></TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblDiffOld" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="210"/>
                        <TextBox x:Name="TxtDiffOld" Grid.Column="1" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnDiffOldBrowse" Grid.Column="2" Content="…" Margin="8,0,0,0" Click="BtnDiffOldBrowse_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblDiffNew" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="210"/>
                        <TextBox x:Name="TxtDiffNew" Grid.Column="1" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnDiffNewBrowse" Grid.Column="2" Content="…" Margin="8,0,0,0" Click="BtnDiffNewBrowse_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnCompare" Style="{StaticResource AccentButton}" Click="BtnCompare_Click"/>
                        <TextBlock x:Name="LblDiffSummary" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextDim}"/>
                    </StackPanel>

                    <ListView x:Name="ListDiff" Grid.Row="3"
                              Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                              FontFamily="Consolas" FontSize="12"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OldNum}" Foreground="{StaticResource TextDim}" TextAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="480">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding OldBrush}" Padding="4,0">
                                                <TextBlock Text="{Binding OldText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NewNum}" Foreground="{StaticResource TextDim}" TextAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="480">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding NewBrush}" Padding="4,0">
                                                <TextBlock Text="{Binding NewText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="DiffEmpty" Grid.Row="3" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                               MaxWidth="440" TextAlignment="Center" FontSize="13.5" LineHeight="21"
                               VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </TabItem>

            <!-- ============ REPAIR (LOT H, spec 10/08) ============ -->
            <TabItem x:Name="TabRepair">
                <TabItem.Header><TextBlock x:Name="TabRepairHeader" Text="Repair" FontSize="14"/></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">

                        <TextBlock x:Name="RepairIntro" TextWrapping="Wrap" FontSize="13.5" LineHeight="21" Foreground="{StaticResource Text}"/>

                        <!-- License -->
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LblRepairLicense" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtRepairLicense" Grid.Column="0" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnRepairVerifyLicense" Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                                            Click="BtnRepairVerifyLicense_Click"/>
                                </Grid>
                                <TextBlock x:Name="LblRepairLicenseStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>
                        </Border>

                        <!-- Plan -->
                        <Button x:Name="BtnRepairBuildPlan" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                Margin="0,18,0,0" Click="BtnRepairBuildPlan_Click"/>
                        <TextBlock x:Name="RepairPlanStatus" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                        <TextBlock x:Name="RepairBlockers" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Warning}"/>

                        <!-- Items -->
                        <ItemsControl x:Name="ListRepairItems" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Top">
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource Text}" MaxWidth="720"/>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="BtnRepairApply" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="14,7"
                                FontWeight="SemiBold" Click="BtnRepairApply_Click"/>
                        <TextBlock x:Name="RepairApplyStatus" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>

                        <!-- Undo -->
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,22,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LblRepairUndo" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox x:Name="ListRepairUndo" Height="110" Background="{StaticResource PanelAlt}"
                                         BorderBrush="{StaticResource Border}" BorderThickness="1" Foreground="{StaticResource Text}"/>
                                <Button x:Name="BtnRepairUndo" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4"
                                        Click="BtnRepairUndo_Click"/>
                                <TextBlock x:Name="RepairUndoStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ============ ABOUT ============ -->
            <TabItem x:Name="TabAbout">
                <TabItem.Header><TextBlock x:Name="TabAboutHeader" Text="About" FontSize="14"/></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Pincab Toolbox" FontSize="30" FontWeight="Black"/>
                        <TextBlock x:Name="AboutTagline" FontSize="17" Foreground="{StaticResource Accent}" Margin="0,2,0,18"/>
                        <TextBlock x:Name="AboutBody" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{StaticResource Text}"/>
                        <TextBlock x:Name="AboutVersion" Margin="0,18,0,0" Foreground="{StaticResource TextDim}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" Padding="10,4"/>
                            <TextBlock x:Name="UpdateResultText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="© 2026 MC Automation" Foreground="{StaticResource TextDim}" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right" Visibility="Collapsed" Click="BtnCancel_Click"/>
                <ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="160" Height="6" IsIndeterminate="True"
                             Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="Transparent"
                             BorderThickness="0" Margin="12,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblStatus" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- first-run onboarding overlay -->
        <Border x:Name="OnboardingOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#E60D0D12">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16"
                    Padding="34,30" MaxWidth="540" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OnbTitle" FontSize="24" FontWeight="Black"/>
                    <TextBlock x:Name="OnbLead" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,10,0,0"/>
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock x:Name="OnbP1" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="OnbP2" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="OnbP3" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="OnbStart" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,24,0,0" Padding="20,9" Click="OnbStart_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
