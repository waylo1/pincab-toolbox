<Window x:Class="PincabToolbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pincab Toolbox"
        Icon="Assets/logo.png"
        Width="1180" Height="780" MinWidth="900" MinHeight="480"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="16,10" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource PanelAlt}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Border}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="DemoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF6E56CF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF5B47B0"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Border}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Logo MC Automation, fond détouré pour se poser sur le bleu nuit du bandeau.
                         L'emblème seul : le nom du produit reste du texte juste à côté, donc net à
                         toutes les résolutions et sélectionnable, plutôt que pixellisé dans l'image. -->
                    <Image Source="Assets/logo.png" Height="40" Margin="0,0,12,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PINCAB" FontSize="22" FontWeight="Black" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text=" TOOLBOX" FontSize="22" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderTagline" Text="" FontSize="13" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" Margin="14,4,0,0"/>
                </StackPanel>
                <Button x:Name="BtnLang" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="FR / EN" Click="BtnLang_Click"/>
            </DockPanel>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,6,10,0">

            <!-- ============ SCANNER ============ -->
            <TabItem x:Name="TabScanner">
                <TabItem.Header><TextBlock x:Name="TabScannerHeader" Text="Scanner" FontSize="14"/></TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- path row -->
                    <Grid Grid.Row="0" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblRoot" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtRoot" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="TxtRoot_TextChanged"/>
                        <Button x:Name="BtnBrowse" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource BrowseButton}" Click="BtnBrowse_Click"/>
                        <Button x:Name="BtnDemo" Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource DemoButton}" Click="BtnDemo_Click"/>
                    </Grid>

                    <!-- ══════════════════ BANDEAU (maquette du 11/08) ══════════════════
                         Jauge + accroche + pastilles de gravité + actions, sur la scène d'arcade.
                         Les pastilles restent des FILTRES cliquables comme avant : mêmes x:Name,
                         mêmes gestionnaires, seule la mise en forme change. -->
                    <!-- Deux Border imbriqués de MÊME CornerRadius : un Border WPF ne rogne pas son
                         contenu aux coins arrondis, donc l'image de fond passe par son Background
                         (ImageBrush, qui suit le rayon) et le voile par le Background du Border
                         intérieur. Un Rectangle superposé laisserait 4 angles carrés visibles. -->
                    <Border Grid.Row="1" Margin="0,2,0,10" CornerRadius="14"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Border.Background>
                            <!-- décor : illustration originale, jamais un artwork de table réelle -->
                            <ImageBrush ImageSource="Assets/arcade-band.png" Stretch="UniformToFill" AlignmentY="Top"/>
                        </Border.Background>
                        <Border CornerRadius="13">
                            <Border.Background>
                                <!-- voile : garde le texte lisible sans noyer l'illustration -->
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E60D1520" Offset="0"/>
                                    <GradientStop Color="#BD0D1520" Offset="0.32"/>
                                    <GradientStop Color="#990D1520" Offset="0.6"/>
                                    <GradientStop Color="#B80D1520" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid Margin="18,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- ─── jauge ─── -->
                                <Grid x:Name="ScoreChip" Grid.Column="0" Width="102" Height="102"
                                      Visibility="Collapsed" Margin="0,0,18,0" VerticalAlignment="Center">
                                    <Ellipse Width="90" Height="90" Stroke="#1E2B3C" StrokeThickness="8"/>
                                    <!-- L'arc de progression est un cercle dont le tiret est calculé en
                                         code-behind (RefreshList) : circonférence / épaisseur = 35.34
                                         unités pour 100 %. Pas de géométrie d'arc à recalculer à la main.
                                         Si le diamètre ou l'épaisseur changent ici, ce nombre change aussi. -->
                                    <Ellipse x:Name="ScoreArc" Width="90" Height="90" StrokeThickness="8"
                                             Stroke="{StaticResource Critical}" StrokeDashCap="Round"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="ScoreValue" FontWeight="Black" FontSize="27"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ScoreGrade" FontWeight="Bold" FontSize="10"
                                                   HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ─── accroche + pastilles ─── -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroHeadline" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ScoreStatus" Foreground="{StaticResource TextDim}"
                                               FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>

                                    <WrapPanel Margin="0,9,0,0">
                                        <Border x:Name="PillCritical" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" MouseLeftButtonUp="PillCritical_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Critical}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipCritical" Text="0" Foreground="{StaticResource Critical}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PillWarning" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" MouseLeftButtonUp="PillWarning_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Warning}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipWarning" Text="0" Foreground="{StaticResource Warning}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PillNote" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" MouseLeftButtonUp="PillNote_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource NoteSev}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipNote" Text="0" Foreground="{StaticResource NoteSev}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PillInfo" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" MouseLeftButtonUp="PillInfo_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource InfoSev}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipInfo" Text="0" Foreground="{StaticResource InfoSev}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PillOk" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,7,5" Cursor="Hand" Opacity="0.4" MouseLeftButtonUp="PillOk_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource OkSev}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ChipOk" Text="0" Foreground="{StaticResource OkSev}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- ─── actions ─── -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="206" Margin="16,0,0,0">
                                    <Button x:Name="BtnScan" Style="{StaticResource AccentButton}" Click="BtnScan_Click"
                                            Padding="14,10" FontSize="14" FontWeight="Bold"/>
                                    <Button x:Name="BtnExport" Margin="0,7,0,0" Click="BtnExport_Click" IsEnabled="False" Padding="10,7"/>
                                    <Button x:Name="BtnCopyForum" Margin="0,7,0,0" Click="BtnCopyForum_Click" IsEnabled="False" Padding="10,7"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <Border x:Name="PriorityBanner" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PriorityAccent" Grid.Column="0" Background="{StaticResource Critical}" CornerRadius="10,0,0,10"/>
                                <StackPanel Grid.Column="1" Margin="16,11">
                                    <TextBlock x:Name="PriorityLabel" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="PriorityText" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,3,0,0"/>

                                    <!-- Chaîne causale (maquette 11/08) : une case par résultat qui a
                                         réellement déclenché la corrélation, dans l'ordre. C'est la
                                         meilleure idée des maquettes — un pincabiste ne lit pas
                                         « BITNESS_MISMATCH_VPM », il lit trois cases dont une est rouge.
                                         Alimentée en code-behind, jamais écrite en dur. -->
                                    <ItemsControl x:Name="ChainNodes" Visibility="Collapsed" Margin="0,10,0,2">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Arrow}" Foreground="{StaticResource TextDim}"
                                                               FontSize="15" VerticalAlignment="Center" Margin="7,0,7,0"/>
                                                    <Border Background="{StaticResource PanelAlt}" BorderBrush="{Binding Accent}"
                                                            BorderThickness="1" CornerRadius="9" Padding="11,7">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5"
                                                                       Foreground="{StaticResource Text}"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="11"
                                                                       Foreground="{Binding Accent}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="PriorityTriggers" FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="PriorityFix" FontSize="13" Foreground="{StaticResource OkSev}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Écran 1 — free aggregate offer, computed by RepairOfferBuilder from the real plan -->
                        <TextBlock x:Name="RepairSummaryLine" Visibility="Collapsed" Foreground="{StaticResource Accent}"
                                   FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,2,6"/>

                        <!-- La recherche filtre la LISTE : sa place est juste au-dessus d'elle, pas dans
                             le bandeau, où elle volait de la hauteur au tableau des résultats. -->
                        <Grid Width="260" Height="30" HorizontalAlignment="Right" Margin="0,0,0,6">
                            <TextBox x:Name="TxtSearch" VerticalContentAlignment="Center" Padding="6,0,0,0"
                                     Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                                     BorderBrush="{StaticResource Border}" TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock x:Name="SearchHint" IsHitTestVisible="False" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="9,0,0,0"/>
                        </Grid>
                        <!-- ADR-006 anti-survente : ce que Repair NE fera jamais, même une fois acheté
                             (RepairOffer.NotAutomatable) — affiché AVANT l'achat, jamais caché. -->
                        <TextBlock x:Name="RepairNotAutomatableLine" Visibility="Collapsed" Foreground="{StaticResource TextDim}"
                                   FontSize="12" TextWrapping="Wrap" Margin="2,0,2,6"/>
                        <TextBlock x:Name="LblPlaceholder" Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" Margin="2,0,2,8"/>
                    </StackPanel>

                    <ListView x:Name="ListFindings" Grid.Row="3"
                              Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="ListFindings_SelectionChanged"
                              GridViewColumnHeader.Click="Header_Click"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Background" Value="{Binding RowBg}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="RowBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                      Columns="{TemplateBinding GridView.ColumnCollection}"
                                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#1FFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#4DFF9F1C"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="ColSeverity" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Fill="{Binding SevBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding SevLabel}" Foreground="{Binding SevBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ColCategory" Width="110" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn x:Name="ColSubject" Width="320">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ColMessage" Width="410">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ColAction" Header="Action" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ActionLabel}" Click="RowAction_Click"
                                                    Padding="9,3" FontSize="12" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- detail panel — populated on row selection -->
                    <Border x:Name="DetailPanel" Grid.Row="3" VerticalAlignment="Bottom" Visibility="Collapsed" MaxHeight="250"
                            Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="8,0,8,8">
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,26,0">
                            <StackPanel>
                                <TextBlock x:Name="DetailSubject" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailMessage" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                <TextBlock x:Name="DetailImpactLabel" Foreground="{StaticResource TextDim}" FontSize="10.5" FontWeight="Bold" Margin="0,13,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="DetailImpact" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>

                                <TextBlock x:Name="DetailCauseLabel" Foreground="{StaticResource TextDim}" FontSize="10.5" FontWeight="Bold" Margin="0,11,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="DetailCause" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>

                                <TextBlock x:Name="DetailFixLabel" Foreground="{StaticResource TextDim}" FontSize="10.5" FontWeight="Bold" Margin="0,11,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="DetailFix" Foreground="{StaticResource OkSev}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>

                                <Button x:Name="DetailActionBtn" HorizontalAlignment="Left" Margin="0,13,0,0" Padding="14,7"
                                        FontWeight="SemiBold" Click="DetailAction_Click"/>

                                <Border x:Name="DetailRepairTag" Visibility="Collapsed" Background="#22FF9F1C" BorderBrush="#55FF9F1C" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,11,0,0" HorizontalAlignment="Left" MaxWidth="420">
                                    <StackPanel>
                                        <TextBlock x:Name="DetailRepairTagText" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" LineHeight="18"/>
                                        <Button x:Name="BtnGotoRepair" Click="BtnGotoRepair_Click" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" Padding="10,4" FontSize="11.5"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="DetailPath" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            </ScrollViewer>
                            <Button x:Name="BtnCloseDetail" Content="✕" ToolTip="Fermer" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="26" Height="26" Padding="0" FontSize="13" Click="BtnCloseDetail_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ DIFF ============ -->
            <TabItem x:Name="TabDiff">
                <TabItem.Header><TextBlock x:Name="TabDiffHeader" Text="Diff" FontSize="14"/></TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblDiffOld" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="210"/>
                        <TextBox x:Name="TxtDiffOld" Grid.Column="1" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnDiffOldBrowse" Grid.Column="2" Content="…" Margin="8,0,0,0" Click="BtnDiffOldBrowse_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblDiffNew" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="210"/>
                        <TextBox x:Name="TxtDiffNew" Grid.Column="1" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnDiffNewBrowse" Grid.Column="2" Content="…" Margin="8,0,0,0" Click="BtnDiffNewBrowse_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnCompare" Style="{StaticResource AccentButton}" Click="BtnCompare_Click"/>
                        <TextBlock x:Name="LblDiffSummary" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextDim}"/>
                    </StackPanel>

                    <ListView x:Name="ListDiff" Grid.Row="3"
                              Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                              FontFamily="Consolas" FontSize="12"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OldNum}" Foreground="{StaticResource TextDim}" TextAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="480">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding OldBrush}" Padding="4,0">
                                                <TextBlock Text="{Binding OldText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NewNum}" Foreground="{StaticResource TextDim}" TextAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="480">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding NewBrush}" Padding="4,0">
                                                <TextBlock Text="{Binding NewText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="DiffEmpty" Grid.Row="3" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                               MaxWidth="440" TextAlignment="Center" FontSize="13.5" LineHeight="21"
                               VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </TabItem>

            <!-- ============ ABOUT ============ -->
            <TabItem x:Name="TabAbout">
                <TabItem.Header><TextBlock x:Name="TabAboutHeader" Text="About" FontSize="14"/></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Pincab Toolbox" FontSize="30" FontWeight="Black"/>
                        <TextBlock x:Name="AboutTagline" FontSize="17" Foreground="{StaticResource Accent}" Margin="0,2,0,18"/>
                        <TextBlock x:Name="AboutBody" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{StaticResource Text}"/>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,20,0,0">
                            <TextBlock x:Name="AboutRoadmap" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                        </Border>
                        <TextBlock x:Name="AboutVersion" Margin="0,18,0,0" Foreground="{StaticResource TextDim}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" Padding="10,4"/>
                            <TextBlock x:Name="UpdateResultText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="© 2026 MC Automation" Foreground="{StaticResource TextDim}" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ REPAIR (LOT H, spec 10/08) ============ -->
            <TabItem x:Name="TabRepair">
                <TabItem.Header><TextBlock x:Name="TabRepairHeader" Text="Repair" FontSize="14"/></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">

                        <TextBlock x:Name="RepairIntro" TextWrapping="Wrap" FontSize="13.5" LineHeight="21" Foreground="{StaticResource Text}"/>

                        <!-- License -->
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LblRepairLicense" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtRepairLicense" Grid.Column="0" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnRepairVerifyLicense" Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                                            Click="BtnRepairVerifyLicense_Click"/>
                                </Grid>
                                <TextBlock x:Name="LblRepairLicenseStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>
                        </Border>

                        <!-- Plan -->
                        <Button x:Name="BtnRepairBuildPlan" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                Margin="0,18,0,0" Click="BtnRepairBuildPlan_Click"/>
                        <TextBlock x:Name="RepairPlanStatus" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                        <TextBlock x:Name="RepairBlockers" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Warning}"/>

                        <!-- Items -->
                        <ItemsControl x:Name="ListRepairItems" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Top">
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource Text}" MaxWidth="720"/>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="BtnRepairApply" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="14,7"
                                FontWeight="SemiBold" Click="BtnRepairApply_Click"/>
                        <TextBlock x:Name="RepairApplyStatus" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>

                        <!-- Undo -->
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,22,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LblRepairUndo" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox x:Name="ListRepairUndo" Height="110" Background="{StaticResource PanelAlt}"
                                         BorderBrush="{StaticResource Border}" BorderThickness="1" Foreground="{StaticResource Text}"/>
                                <Button x:Name="BtnRepairUndo" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4"
                                        Click="BtnRepairUndo_Click"/>
                                <TextBlock x:Name="RepairUndoStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right" Visibility="Collapsed" Click="BtnCancel_Click"/>
                <ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="160" Height="6" IsIndeterminate="True"
                             Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="Transparent"
                             BorderThickness="0" Margin="12,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblStatus" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- first-run onboarding overlay -->
        <Border x:Name="OnboardingOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#E60D0D12">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16"
                    Padding="34,30" MaxWidth="540" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OnbTitle" FontSize="24" FontWeight="Black"/>
                    <TextBlock x:Name="OnbLead" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,10,0,0"/>
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock x:Name="OnbP1" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="OnbP2" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="OnbP3" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="OnbStart" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,24,0,0" Padding="20,9" Click="OnbStart_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
