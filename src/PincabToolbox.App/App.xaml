<Application x:Class="PincabToolbox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark palette -->
        <SolidColorBrush x:Key="Bg" Color="#FF15151B"/>
        <SolidColorBrush x:Key="Panel" Color="#FF1E1E26"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#FF262630"/>
        <SolidColorBrush x:Key="Border" Color="#FF34343F"/>
        <SolidColorBrush x:Key="Text" Color="#FFECECF2"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF9C9CAC"/>
        <!-- Rebranding 17/08 : le nouveau logo « PIN CAB TOOL BOX » porte une identité noir + vert
             olive-lime + argent, l'orange n'est plus une couleur de marque. Vert échantillonné à la
             pipette sur Assets/logo-full.png (dominant olive-lime ~#708830, reflets jusqu'à ~#94C818).
             Volontairement plus jaune que l'émeraude de sévérité Ok/OkSev (#46C06E, §2.9 du plan) pour
             qu'un score sain ne se confonde jamais avec la couleur de marque. -->
        <SolidColorBrush x:Key="Accent" Color="#FF708830"/>
        <SolidColorBrush x:Key="AccentDark" Color="#FF4E5F22"/>
        <SolidColorBrush x:Key="Critical" Color="#FFE5484D"/>
        <SolidColorBrush x:Key="Warning" Color="#FFF5A524"/>
        <SolidColorBrush x:Key="InfoSev" Color="#FF3E9CF3"/>
        <!-- Severity.Note — heuristic "worth a look" fact (Doctrine Note), deliberately distinct from
             InfoSev (neutral confirmation, blue) and Warning (actionable, orange). Violet reads as a
             separate annotation register without borrowing the alarm colours. -->
        <SolidColorBrush x:Key="NoteSev" Color="#FFB58DF5"/>
        <SolidColorBrush x:Key="OkSev" Color="#FF46C06E"/>

        <!-- Échelle d'espacement 8px (lot 1) — jetons nommés par rôle, consommés par les lots 2 et 5
             au fil des zones qu'ils retouchent. N'existait pas avant : tous les Margin/Padding
             restent des littéraux inline ailleurs dans l'app, ce lot ne les remplace pas en masse. -->
        <Thickness x:Key="SpaceXs">4</Thickness>
        <Thickness x:Key="SpaceSm">8</Thickness>
        <Thickness x:Key="SpaceMd">16</Thickness>
        <Thickness x:Key="SpaceLg">24</Thickness>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FF1A1206"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Lot 4 : badge de sévérité partagé — une seule définition de la FORME (coins arrondis,
             padding, épaisseur de bordure), utilisée par le badge de gravité des cartes de cause
             (CauseCardTpl). La COULEUR reste fournie par l'appelant via Background/BorderBrush liés
             en code-behind à SevBrushOf/SevTint (CauseCardRow.BadgeBg/BadgeBorder) — une valeur
             locale prime toujours sur un Setter de Style, donc appliquer ce style ne change ni ne
             duplique aucune couleur de sévérité. -->
        <Style x:Key="SeverityBadge" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
