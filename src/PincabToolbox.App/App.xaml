<Application x:Class="PincabToolbox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark palette -->
        <SolidColorBrush x:Key="Bg" Color="#FF15151B"/>
        <SolidColorBrush x:Key="Panel" Color="#FF1E1E26"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#FF262630"/>
        <SolidColorBrush x:Key="Border" Color="#FF34343F"/>
        <SolidColorBrush x:Key="Text" Color="#FFECECF2"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF9C9CAC"/>
        <SolidColorBrush x:Key="Accent" Color="#FFFF9F1C"/>
        <SolidColorBrush x:Key="AccentDark" Color="#FFCC7A00"/>
        <SolidColorBrush x:Key="Critical" Color="#FFE5484D"/>
        <SolidColorBrush x:Key="Warning" Color="#FFF5A524"/>
        <SolidColorBrush x:Key="InfoSev" Color="#FF3E9CF3"/>
        <!-- Severity.Note — heuristic "worth a look" fact (Doctrine Note), deliberately distinct from
             InfoSev (neutral confirmation, blue) and Warning (actionable, orange). Violet reads as a
             separate annotation register without borrowing the alarm colours. -->
        <SolidColorBrush x:Key="NoteSev" Color="#FFB58DF5"/>
        <SolidColorBrush x:Key="OkSev" Color="#FF46C06E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FF1A1206"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
