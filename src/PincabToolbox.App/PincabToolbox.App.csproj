<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PincabToolbox</AssemblyName>
    <RootNamespace>PincabToolbox.App</RootNamespace>
    <Version>0.1.2</Version>
    <Company>MC Automation</Company>
    <Product>Pincab Toolbox</Product>
    <AssemblyTitle>Pincab Toolbox — Free Scanner</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PincabToolbox.Core\PincabToolbox.Core.csproj" />
    <!-- Écran 1 (offre Repair gratuite) via RepairOfferBuilder.cs. Preflight/Apply/Undo ARE wired
         from the App (LOT H, spec 10/08, ADR-012) — see RepairSession.Apply/Preflight/Undo calls in
         MainWindow.xaml.cs. This comment previously said the opposite (stale since 10/08 — Lot H was
         decided and delivered that same day; the comment was never updated). Corrected 18/08/2026. -->
    <ProjectReference Include="..\PincabToolbox.Repair\PincabToolbox.Repair.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bandeau décoratif de l'écran Scanner. Build action Resource (et non Content) : l'image est
         embarquée DANS l'assembly, donc elle survit au publish single-file et ne peut pas être
         oubliée sur une clé USB à côté de l'exe. Illustration originale, aucun artwork de table
         réelle (droits Bally/Williams) — voir docs/maquette-scanner-2026-08-11.html. -->
    <Resource Include="Assets\background.png" />
    <!-- Logo MC Automation fourni par Maxime, fond noir détouré pour se poser sur le bleu nuit.
         logo.png = emblème seul (en-tête + icône de fenêtre) ; logo-full.png = emblème + nom,
         gardé pour l'écran À propos et les visuels marketing. -->
    <Resource Include="Assets\logo.png" />
    <!-- ⚠ NE PAS repasser logo-full.png en <SplashScreen>. Tenté le 17/08, retiré le 18/08.
         Un item SplashScreen fait générer par WPF un Main() qui ouvre, AVANT que l'Application
         et le Dispatcher ne tournent, une fenêtre native superposée (layered + topmost + sans
         bordure) créée directement en P/Invoke user32/gdi32. Sur un exe NON SIGNÉ publié en
         single-file auto-extractible, ce profil de démarrage a suffi à faire basculer le
         « Contrôle intelligent des applications » de Windows 11 en blocage DUR (« application
         potentiellement dangereuse », sans bouton « Exécuter quand même », contrairement à
         SmartScreen) : l'utilisateur ne pouvait plus lancer l'app du tout. C'était le seul
         changement de build entre le dernier exe qui passait et celui qui bloquait.
         À ne ré-tenter qu'après signature de code EV, ou via une fenêtre WPF ordinaire ouverte
         depuis l'app une fois le runtime démarré (jamais ce mécanisme natif pré-init). -->
    <Resource Include="Assets\logo-full.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\profiles\vpx-popper.json" Link="profiles\vpx-popper.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\knowledge\pack-2026.08.json" Link="knowledge\pack-2026.08.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="DemoData\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
