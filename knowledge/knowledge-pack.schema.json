{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flipsync.dev/schema/knowledge-pack-1.json",
  "title": "Pincab Toolbox — Knowledge Pack",
  "description": "Format du pack de connaissance. La connaissance est de la DONNÉE (ARCHITECTURE-KnowledgeEngine §4) ; une règle ne peut invoquer qu'une action du registre compilé (ADR-005).",
  "type": "object",
  "required": ["packVersion", "schemaVersion", "entries"],
  "additionalProperties": false,

  "properties": {
    "schemaVersion": { "const": 1 },
    "packVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}$",
      "description": "Millésime, ex. 2026.08 — c'est ce que l'abonnement de mises à jour livre (ADR-002)."
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Version minimale de l'app. Un pack plus récent que l'app doit dégrader proprement, pas planter."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/knowledgeEntry" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    }
  },

  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,47}$",
      "description": "Clé de jointure de toute la pipeline : détecteur, connaissance, règles, scénarios."
    },

    "knowledgeEntry": {
      "type": "object",
      "required": ["code", "category", "severity", "titleFr", "titleEn",
                   "explanationFr", "explanationEn", "impactFr", "impactEn",
                   "causeFr", "causeEn", "verificationFr", "verificationEn"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "category": {
          "enum": ["rom", "bitness", "completeness", "compat", "security", "dependencies", "updates",
                   "process", "media-orphan"],
          "description": "Doit correspondre à un scanner enregistré dans ScanEngine."
        },
        "severity": { "enum": ["Ok", "Info", "Warning", "Critical"] },

        "titleFr": { "$ref": "#/$defs/text" },
        "titleEn": { "$ref": "#/$defs/text" },

        "playerFr": { "$ref": "#/$defs/text" },
        "playerEn": { "$ref": "#/$defs/text" },

        "explanationFr": { "$ref": "#/$defs/text" },
        "explanationEn": { "$ref": "#/$defs/text" },
        "impactFr": { "$ref": "#/$defs/text" },
        "impactEn": { "$ref": "#/$defs/text" },
        "causeFr": { "$ref": "#/$defs/text" },
        "causeEn": { "$ref": "#/$defs/text" },

        "verificationFr": {
          "$ref": "#/$defs/text",
          "description": "COMMENT le check vérifie, en général. Statique. À ne pas confondre avec Evidence (ADR-003), qui est ce qui a été observé chez CET utilisateur."
        },
        "verificationEn": { "$ref": "#/$defs/text" },

        "references": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "pattern": "^https://" },
          "description": "Liens forum/wiki/dépôt officiel. HTTPS uniquement."
        },

        "appliesTo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vpxMin": { "type": "string" },
            "vpxMax": { "type": "string" },
            "popperMin": { "type": "string" }
          }
        },

        "repairRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/repairRule" },
          "description": "Vide = diagnostic seul. Le finding retombe alors en ManualOnly."
        }
      }
    },

    "repairRule": {
      "type": "object",
      "required": ["id", "actionId", "repairConfidence", "reversible"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },

        "actionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,47}$",
          "description": "DOIT exister dans le registre compilé (ADR-005). Un ActionId inconnu ne plante pas : la règle est ignorée et le finding retombe en ManualOnly."
        },

        "parameters": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Typés et validés par l'action elle-même. Jamais de chaîne interprétée à l'exécution."
        },

        "repairConfidence": {
          "type": "integer", "minimum": 0, "maximum": 100,
          "description": "≥95 + réversible → Automatic · 70-94 → confirmation · <70 → manuel seul."
        },

        "reversible": {
          "type": "boolean",
          "description": "IRepairAction.IsReversibleByNature a le dernier mot : si l'action dit non, la règle ne peut pas dire oui."
        },

        "backupRequired": { "type": "boolean", "default": true },

        "manualProcedureFr": { "$ref": "#/$defs/text" },
        "manualProcedureEn": { "$ref": "#/$defs/text" }
      }
    },

    "scenario": {
      "type": "object",
      "required": ["id", "titleFr", "titleEn", "requires", "explanationFr", "explanationEn"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "titleFr": { "$ref": "#/$defs/text" },
        "titleEn": { "$ref": "#/$defs/text" },

        "requires": {
          "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/code" },
          "description": "Au moins DEUX codes : des findings coïncidents ne font pas une panne (anti-faux-positif)."
        },
        "supports": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "excludes": { "type": "array", "items": { "$ref": "#/$defs/code" } },

        "baseConfidence": { "type": "integer", "minimum": 0, "maximum": 100 },

        "explanationFr": { "$ref": "#/$defs/text" },
        "explanationEn": { "$ref": "#/$defs/text" },

        "repairPlaybook": {
          "type": "array",
          "description": "Suite ORDONNÉE. L'ordre compte, et l'ensemble est UNE transaction.",
          "items": {
            "type": "object",
            "required": ["step", "ruleId"],
            "additionalProperties": false,
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "ruleId": { "type": "string" },
              "manualOnly": {
                "type": "boolean", "default": false,
                "description": "Rend le playbook Partial. Doit être annoncé AVANT d'agir."
              },
              "reasonFr": { "$ref": "#/$defs/text" },
              "reasonEn": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },

    "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
  }
}
